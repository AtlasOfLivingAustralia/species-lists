<footer class="example-theme-footer">
    <div class="{{containerClass}} example-theme-footer-inner">
        <p>
            <strong>Example Atlas</strong> — an example theme shipped with the community build of
            lists-ui, to show runtime theming (<code>VITE_THEME_HEADER_URL</code>,
            <code>VITE_THEME_FOOTER_URL</code>, <code>VITE_THEME_CSS_URL</code> in
            <code>config.local.js</code>). Not affiliated with the Atlas of Living Australia.
        </p>
        <div class="{{loginStatus}}">
            <a href="{{loginURL}}" role="button" class="loginBtn example-theme-btn">Login</a>
            <a href="{{logoutURL}}" role="button" class="logoutBtn example-theme-btn">Logout</a>
        </div>
    </div>
</footer>
