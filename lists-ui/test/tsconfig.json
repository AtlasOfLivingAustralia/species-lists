{
  "comment": "Type-checks the node:test unit tests, which run through node's type stripping and are therefore not checked at run time. `yarn typecheck` includes this project.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "#/*": ["../src/*"]
    }
  },
  "include": ["**/*.ts"]
}
